{"value":[{"messageId":"82fa4e76-67cf-45fc-8a1e-5ce85f3425d5","conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:23:07.562Z","endpoint":"copilot","error":false,"expiredAt":null,"isCreatedByUser":true,"model":null,"parentMessageId":"00000000-0000-0000-0000-000000000000","sender":"User","text":"heyo","tokenCount":6,"unfinished":false,"updatedAt":"2026-09-23T00:23:07.639Z"},{"messageId":"7ab3bf72-78eb-4f63-ad37-f20824c14b6b","attachments":[],"content":[{"type":"error","error":"An error occurred while processing the request: Unsupported LLM provider: copilot"}],"conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:23:07.612Z","endpoint":"copilot","error":false,"expiredAt":null,"isCreatedByUser":false,"model":"gpt-4o","parentMessageId":"82fa4e76-67cf-45fc-8a1e-5ce85f3425d5","sender":"GPT-4o","text":"","tokenCount":4,"unfinished":false,"updatedAt":"2026-09-23T00:23:07.612Z"},{"messageId":"307dd868-b2e7-4085-a7b7-d5cb67381607","conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:15.786Z","endpoint":"google","error":false,"expiredAt":null,"isCreatedByUser":true,"model":null,"parentMessageId":"7ab3bf72-78eb-4f63-ad37-f20824c14b6b","sender":"User","text":"heyo","tokenCount":6,"unfinished":false,"updatedAt":"2026-09-23T00:33:18.262Z"},{"messageId":"4c43009e-1672-4e4f-803d-b9a3fa533258","attachments":[],"content":[{"type":"think","think":"**Acknowledge the Greeting**\n\nI've registered the casual greeting and have started formulating a suitable response. My initial thought is to meet the tone with a simple \"Hey!\" or similar. Further, I'm considering following up with a friendly inquiry.\n\n\n**Craft the Response**\n\nI've crafted a quick response to the greeting! My thoughts settled on \"Hey!\" as the initial acknowledgment. Next, I considered inquiries for an opening. Ultimately, I am ready to return with a friendly \"Hey!\" and a straightforward \"What's up?\" to invite further interaction.\n\n\n"},{"type":"text","text":"Hey there! What's up? 👋"}],"conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:18.243Z","endpoint":"google","error":false,"expiredAt":null,"isCreatedByUser":false,"model":"models/gemini-2.5-flash","parentMessageId":"307dd868-b2e7-4085-a7b7-d5cb67381607","sender":"Gemini","text":"","tokenCount":117,"unfinished":false,"updatedAt":"2026-09-23T00:33:18.243Z"},{"messageId":"44333b34-a986-4fa5-b39e-c31d1cc060fc","conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:26.081Z","endpoint":"deepseek","error":false,"expiredAt":null,"isCreatedByUser":true,"model":null,"parentMessageId":"4c43009e-1672-4e4f-803d-b9a3fa533258","sender":"User","text":"how are ya?","tokenCount":8,"unfinished":false,"updatedAt":"2026-09-23T00:33:27.432Z"},{"messageId":"36c981c4-800f-4ffd-94af-669bae1671c3","attachments":[],"content":[{"type":"text","text":"Doing well, thanks for asking! Ready to help with whatever you've got going on. How about you — what brings you here today?"}],"conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:27.421Z","endpoint":"deepseek","error":false,"expiredAt":null,"isCreatedByUser":false,"model":"deepseek-chat","parentMessageId":"44333b34-a986-4fa5-b39e-c31d1cc060fc","sender":"Deepseek","text":"","tokenCount":29,"unfinished":false,"updatedAt":"2026-09-23T00:33:27.421Z"},{"messageId":"5a4ddd05-408b-4a3a-8e15-801f30a40d2c","conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:35.668Z","endpoint":"github-copilot","error":false,"expiredAt":null,"isCreatedByUser":true,"model":null,"parentMessageId":"36c981c4-800f-4ffd-94af-669bae1671c3","sender":"User","text":"are u there?","tokenCount":8,"unfinished":false,"updatedAt":"2026-09-23T00:33:37.044Z"},{"messageId":"073d4349-9f14-4d7e-8749-289014bf22f9","attachments":[],"content":[{"type":"text","text":"Yep, I'm here! 😊 What's on your mind?"}],"conversationId":"9f71251a-36af-43eb-92c1-55c8402671bc","createdAt":"2026-09-23T00:33:37.028Z","endpoint":"github-copilot","error":false,"expiredAt":null,"isCreatedByUser":false,"model":"gpt-4o","parentMessageId":"5a4ddd05-408b-4a3a-8e15-801f30a40d2c","sender":"GPT-4o","text":"","tokenCount":11,"unfinished":false,"updatedAt":"2026-09-23T00:33:37.028Z"}],"expires":1790125456916}
