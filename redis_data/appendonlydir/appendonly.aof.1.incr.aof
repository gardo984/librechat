{"value":[{"messageId":"c0e1cd06-110e-442b-9d53-03fc400b7c83","conversationId":"187b9a54-1d47-436f-a209-4bdd49969363","createdAt":"2026-03-02T17:12:52.550Z","endpoint":"deepseek","error":false,"expiredAt":null,"isCreatedByUser":true,"model":null,"parentMessageId":"00000000-0000-0000-0000-000000000000","sender":"User","text":"Please write a hello world in python, smth short and concise.","tokenCount":18,"unfinished":false,"updatedAt":"2026-03-02T17:12:55.501Z"},{"messageId":"353becfb-346f-4e3d-8b2b-e98cd9cb2efa","attachments":[],"content":[{"type":"text","text":"```python\nprint(\"Hello, World!\")\n```"}],"conversationId":"187b9a54-1d47-436f-a209-4bdd49969363","createdAt":"2026-03-02T17:12:55.486Z","endpoint":"deepseek","error":false,"expiredAt":null,"isCreatedByUser":false,"model":"deepseek-coder","parentMessageId":"c0e1cd06-110e-442b-9d53-03fc400b7c83","sender":"Deepseek","text":"","tokenCount":10,"unfinished":false,"updatedAt":"2026-03-02T17:12:55.486Z"}],"expires":1772496418290}
